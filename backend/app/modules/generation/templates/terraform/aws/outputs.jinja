{% for comp in components %}
output "{{ comp.name }}_ecr_repository_url" {
  description = "Registry URL for {{ comp.name }} container builds"
  value       = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${data.aws_region.current.name}.amazonaws.com/${lower(var.project_name)}-{{ comp.name }}"
}

{% if comp.aws_compute_choice == 'ec2' or (compute_choice == 'ec2' and not comp.aws_compute_choice) %}
output "{{ comp.name }}_public_ip" {
  description = "Public IP address of the {{ comp.name }} virtual machine"
  value       = {% if comp.use_eip or (use_eip and loop.first) %}aws_eip.{{ comp.name }}_eip.public_ip{% else %}aws_instance.{{ comp.name }}.public_ip{% endif %}
}
{% endif %}
{% endfor %}
