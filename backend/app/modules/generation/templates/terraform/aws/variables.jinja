variable "aws_region" {
  description = "AWS region to deploy resources into"
  type        = string
  default     = "{{ aws_region | default('us-east-1') }}"
}

variable "project_name" {
  description = "Prefix for all resource naming"
  type        = string
  default     = "{{ project_name | default('code2cloud-app') }}"
}

variable "environment" {
  description = "Target deployment environment"
  type        = string
  default     = "{{ environment | default('production') }}"
}

variable "storage_size_gb" {
  description = "Root SSD block storage volume size in GB"
  type        = number
  default     = {{ storage_size_gb | default(20) }}
}

{% if db_enabled %}
variable "db_password" {
  description = "Master password for the managed RDS database"
  type        = string
  default     = "Code2CloudPass123!"
  sensitive   = true
}
{% endif %}

{% if swap_enabled %}
variable "swap_size_gb" {
  description = "Linux swap file allocation size in GB"
  type        = number
  default     = {{ swap_size_gb | default(2) }}
}
{% endif %}

