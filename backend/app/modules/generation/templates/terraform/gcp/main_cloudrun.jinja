{% if db_enabled %}
# --- Managed Database (Cloud SQL) ---
resource "google_sql_database_instance" "db" {
  name             = "${lower(var.project_name)}-db"
  database_version = "{{ 'POSTGRES_15' if db_engine == 'postgres' else 'MYSQL_8_0' }}"
  region           = var.gcp_region
  deletion_protection = false

  settings {
    tier      = "{{ db_instance_class | default('db-f1-micro') }}"
    disk_size = 20
    disk_type = "PD_SSD"
    ip_configuration {
      ipv4_enabled = true
      authorized_networks {
        name  = "allow-all"
        value = "0.0.0.0/0"
      }
    }
    user_labels = {
      environment = var.environment
    }
  }
}

resource "google_sql_database" "app_db" {
  name     = "{{ db_name | default('app_db') }}"
  instance = google_sql_database_instance.db.name
}

resource "google_sql_user" "db_user" {
  name     = "{{ db_user | default('c2c_admin') }}"
  instance = google_sql_database_instance.db.name
  password = var.db_password
}
{% endif %}

# --- Cloud Run Services & Container Repositories ---
{% for comp in components %}
resource "google_artifact_registry_repository" "{{ comp.name }}" {
  location      = var.gcp_region
  repository_id = "${lower(var.project_name)}-{{ comp.name }}"
  description   = "Docker repository for {{ comp.name }}"
  format        = "DOCKER"
  labels = {
    environment = var.environment
  }
}

resource "google_cloud_run_v2_service" "{{ comp.name }}" {
  name     = "${var.project_name}-{{ comp.name }}"
  location = var.gcp_region
  ingress  = "INGRESS_TRAFFIC_ALL"

  template {
    labels = {
      environment = var.environment
    }
    containers {
      image = "${var.gcp_region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.{{ comp.name }}.repository_id}/{{ comp.name }}:latest"
      
      resources {
        limits = {
          cpu    = "{{ comp.cpu | default(cpu | default('1')) }}"
          memory = "{{ comp.memory | default(memory | default('512Mi')) }}"
        }
      }
      
      ports {
        container_port = {{ comp.port | default(3000) }}
      }

      env {
        name  = "PORT"
        value = "{{ comp.port | default(3000) }}"
      }
      env {
        name  = "ENVIRONMENT"
        value = var.environment
      }
      {%- if db_enabled %}
      env {
        name  = "DB_HOST"
        value = google_sql_database_instance.db.public_ip_address
      }
      env {
        name  = "DB_PORT"
        value = "{{ db_port | default(5432) }}"
      }
      env {
        name  = "DB_USER"
        value = "{{ db_user | default('c2c_admin') }}"
      }
      env {
        name  = "DB_PASSWORD"
        value = var.db_password
      }
      env {
        name  = "DB_NAME"
        value = "{{ db_name | default('app_db') }}"
      }
      env {
        name  = "DATABASE_URL"
        value = "{{ 'postgres' if db_engine == 'postgres' else 'mysql' }}://{{ db_user | default('c2c_admin') }}:${var.db_password}@${google_sql_database_instance.db.public_ip_address}:{{ db_port | default(5432) }}/{{ db_name | default('app_db') }}"
      }
      {%- endif %}
      {%- if comp.depends_on %}
      {%- for dep in comp.depends_on %}
      env {
        name  = "{{ dep | upper }}_URL"
        value = "http://localhost:{{ comp.port | default(3000) }}"
      }
      {%- endfor %}
      {%- endif %}

      # Dynamic application environment variables
      dynamic "env" {
        for_each = can(jsondecode(var.app_env_vars)["{{ comp.name }}"]) ? jsondecode(var.app_env_vars)["{{ comp.name }}"] : try(jsondecode(var.app_env_vars), {})
        content {
          name  = env.key
          value = tostring(env.value)
        }
      }
    }
  }

  depends_on = [google_artifact_registry_repository.{{ comp.name }}]
}

# Allow public unauthenticated access to the Cloud Run service
resource "google_cloud_run_v2_service_iam_member" "noauth_{{ comp.name }}" {
  location = google_cloud_run_v2_service.{{ comp.name }}.location
  name     = google_cloud_run_v2_service.{{ comp.name }}.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}
{% endfor %}

