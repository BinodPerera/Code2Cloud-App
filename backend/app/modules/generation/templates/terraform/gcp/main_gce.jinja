# --- Networking (VPC Setup) ---
resource "google_compute_network" "vpc" {
  name                    = "${var.project_name}-vpc"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "subnet" {
  name          = "${var.project_name}-subnet"
  ip_cidr_range = "10.0.1.0/24"
  region        = var.gcp_region
  network       = google_compute_network.vpc.id
}

# --- Firewall Rule for Public Access ---
resource "google_compute_firewall" "allow_http" {
  name    = "${var.project_name}-allow-http"
  network = google_compute_network.vpc.name

  allow {
    protocol = "tcp"
    ports    = ["22", "80", {% for comp in components %}"{{ comp.port | default(3000) }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }

  source_ranges = ["0.0.0.0/0"]
  target_tags   = ["web-server"]
}

{% if db_enabled %}
# --- Managed Database (Cloud SQL) ---
resource "google_sql_database_instance" "db" {
  name             = "${lower(var.project_name)}-db"
  database_version = "{{ 'POSTGRES_15' if db_engine == 'postgres' else 'MYSQL_8_0' }}"
  region           = var.gcp_region
  deletion_protection = false

  settings {
    tier      = "{{ db_instance_class | default('db-f1-micro') }}"
    disk_size = {{ db_allocated_storage | default(20) }}
    disk_type = "PD_SSD"
    ip_configuration {
      ipv4_enabled = true
      authorized_networks {
        name  = "allow-all"
        value = "0.0.0.0/0"
      }
    }
    user_labels = {
      environment = var.environment
    }
  }
}

resource "google_sql_database" "app_db" {
  name     = "{{ db_name | default('app_db') }}"
  instance = google_sql_database_instance.db.name
}

resource "google_sql_user" "db_user" {
  name     = "{{ db_user | default('c2c_admin') }}"
  instance = google_sql_database_instance.db.name
  password = var.db_password
}
{% endif %}

# --- Static IP Allocation (Conditional) ---
{% for comp in components %}
{% if comp.use_static_ip or (use_static_ip and loop.first) %}
resource "google_compute_address" "{{ comp.name }}_static_ip" {
  name   = "${var.project_name}-{{ comp.name }}-static-ip"
  region = var.gcp_region
}
{% endif %}
{% endfor %}

# --- Compute Engine Instances & Container Repositories ---
{% for comp in components %}
resource "google_artifact_registry_repository" "{{ comp.name }}" {
  location      = var.gcp_region
  repository_id = "${lower(var.project_name)}-{{ comp.name }}"
  description   = "Docker repository for {{ comp.name }}"
  format        = "DOCKER"
  labels = {
    environment = var.environment
  }
}

resource "google_compute_instance" "{{ comp.name }}" {
  name         = "${var.project_name}-{{ comp.name }}-vm"
  machine_type = "{{ comp.machine_type | default(machine_type | default('e2-micro')) }}"
  zone         = "${var.gcp_region}-a"
  tags         = ["web-server"]
  labels = {
    environment = var.environment
  }

  boot_disk {
    initialize_params {
      image = "debian-cloud/debian-11"
      size  = {{ comp.storage_size_gb | default('var.storage_size_gb') }}
      type  = "{{ storage_type | default('pd-ssd') }}"
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.subnet.id
    access_config {
      {% if comp.use_static_ip or (use_static_ip and loop.first) %}
      nat_ip = google_compute_address.{{ comp.name }}_static_ip.address
      {% endif %}
    }
  }

  # Service Account with Artifact Registry read access
  service_account {
    scopes = ["https://www.googleapis.com/auth/devstorage.read_only", "https://www.googleapis.com/auth/logging.write", "https://www.googleapis.com/auth/monitoring.write"]
  }

  metadata_startup_script = <<-EOT
    #!/bin/bash
    while fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock >/dev/null 2>&1; do
      echo "Waiting for other apt process to finish..."
      sleep 3
    done
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update
    apt-get install -y docker-ce docker-ce-cli containerd.io
    {%- if comp.swap_enabled or (swap_enabled and comp.swap_enabled is not defined) %}

    # Configure Linux Swap Memory
    fallocate -l {{ comp.swap_size_gb | default('var.swap_size_gb') }}G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=$(expr {{ comp.swap_size_gb | default('var.swap_size_gb') }} \* 1024)
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
    sysctl vm.swappiness=10
    echo 'vm.swappiness=10' >> /etc/sysctl.conf
    {%- endif %}
    
    # Authenticate Docker to Artifact Registry
    gcloud auth configure-docker ${var.gcp_region}-docker.pkg.dev --quiet
    
    # Run the container mapping host port 80 to container port
    docker run -d -p 80:{{ comp.port | default(3000) }} \
      --name {{ comp.name }} \
      --restart always \
      -e PORT={{ comp.port | default(3000) }} \
      -e ENVIRONMENT=${var.environment} \
      {%- if db_enabled %}
      -e DB_HOST=${google_sql_database_instance.db.public_ip_address} \
      -e DB_PORT={{ db_port | default(5432) }} \
      -e DB_USER={{ db_user | default('c2c_admin') }} \
      -e DB_PASSWORD=${var.db_password} \
      -e DB_NAME={{ db_name | default('app_db') }} \
      -e DATABASE_URL="{{ 'postgres' if db_engine == 'postgres' else 'mysql' }}://{{ db_user | default('c2c_admin') }}:${var.db_password}@${google_sql_database_instance.db.public_ip_address}:{{ db_port | default(5432) }}/{{ db_name | default('app_db') }}" \
      {%- endif %}
      {%- if comp.depends_on %}
      {%- for dep in comp.depends_on %}
      -e {{ dep | upper }}_URL=http://localhost:{{ comp.port | default(3000) }} \
      {%- endfor %}
      {%- endif %}
      ${var.gcp_region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.{{ comp.name }}.repository_id}/{{ comp.name }}:latest
  EOT
}
{% endfor %}

