# --- Build Stage ---
FROM node:{{ node_version | default('22-alpine') }} AS builder
WORKDIR /app
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY . .
# Generate Prisma Client if prisma schema exists
RUN if [ -d "prisma" ] || [ -f "prisma/schema.prisma" ]; then npx prisma generate; fi
# Optional: run build if a frontend asset or typescript build script exists
RUN npm run build --if-present

# --- Production Stage ---
FROM node:{{ node_version | default('22-alpine') }}
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --only=production; else npm install --omit=dev; fi
COPY --from=builder /app ./

EXPOSE {{ port | default(3000) }}
CMD ["npm", "start"]
