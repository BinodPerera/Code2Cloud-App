name: Deploy to AWS (Code2Cloud)

on:
  push:
    branches:
      - {{ branch }}
  workflow_dispatch:
    inputs:
      skip_build:
        description: 'Skip Docker image build and only apply infrastructure/env updates'
        required: false
        default: false
        type: boolean

concurrency:
  group: deploy-{{ branch }}
  cancel-in-progress: true

jobs:
  deploy:
    name: Build & Deploy to AWS
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # Setup AWS credentials
      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: {% raw %}${{ secrets.AWS_ACCESS_KEY_ID }}{% endraw %}
          aws-secret-access-key: {% raw %}${{ secrets.AWS_SECRET_ACCESS_KEY }}{% endraw %}
          aws-session-token: {% raw %}${{ secrets.AWS_SESSION_TOKEN }}{% endraw %}
          aws-region: {{ aws_region | default('us-east-1') }}

      {% if registry_type == 'dockerhub' %}
      # Log in to Docker Hub
      - name: Log in to Docker Hub
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        uses: docker/login-action@v3
        with:
          username: {% raw %}${{ secrets.DOCKER_USERNAME }}{% endraw %}
          password: {% raw %}${{ secrets.DOCKER_PASSWORD }}{% endraw %}

      {% for comp in components %}
      - name: Build, tag, and push {{ comp.name }} to Docker Hub
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        env:
          DOCKER_USERNAME: {% raw %}${{ secrets.DOCKER_USERNAME }}{% endraw %}
          IMAGE_NAME: {{ repo_name | lower }}-{{ comp.name }}
          IMAGE_TAG: {% raw %}${{ github.sha }}{% endraw %}
        run: |
          docker build -t $DOCKER_USERNAME/$IMAGE_NAME:$IMAGE_TAG -t $DOCKER_USERNAME/$IMAGE_NAME:latest {{ comp.path }}
          docker push $DOCKER_USERNAME/$IMAGE_NAME:$IMAGE_TAG
          docker push $DOCKER_USERNAME/$IMAGE_NAME:latest
      {% endfor %}
      {% else %}
      # Log in and push to Amazon ECR (Default)
      - name: Login to Amazon ECR
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      {% for comp in components %}
      - name: Build, tag, and push {{ comp.name }} to Amazon ECR
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        env:
          ECR_REGISTRY: {% raw %}${{ steps.login-ecr.outputs.registry }}{% endraw %}
          ECR_REPOSITORY: {{ repo_name | lower }}-{{ comp.name }}
          IMAGE_TAG: {% raw %}${{ github.sha }}{% endraw %}
        run: |
          # Create repository if it doesn't exist
          aws ecr describe-repositories --repository-names $ECR_REPOSITORY || aws ecr create-repository --repository-name $ECR_REPOSITORY
          
          docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG -t $ECR_REGISTRY/$ECR_REPOSITORY:latest {{ comp.path }}
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:latest
      {% endfor %}
      {% endif %}

      # Setup Terraform and Apply
      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.7.0

      # Ensure Terraform Remote State S3 Bucket Exists
      - name: Configure Terraform Remote State S3 Bucket
        id: state-bucket
        run: |
          ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
          BUCKET="code2cloud-tfstate-${ACCOUNT_ID}-{{ aws_region | default('us-east-1') }}"
          echo "bucket_name=$BUCKET" >> $GITHUB_OUTPUT
          
          if ! aws s3api head-bucket --bucket "$BUCKET" 2>/dev/null; then
            echo "Creating S3 remote state bucket: $BUCKET"
            {% if aws_region and aws_region != 'us-east-1' %}
            aws s3api create-bucket --bucket "$BUCKET" --region {{ aws_region }} --create-bucket-configuration LocationConstraint={{ aws_region }} || true
            {% else %}
            aws s3api create-bucket --bucket "$BUCKET" --region us-east-1 || true
            {% endif %}
            aws s3api put-bucket-versioning --bucket "$BUCKET" --versioning-configuration Status=Enabled || true
            aws s3api put-bucket-encryption --bucket "$BUCKET" --server-side-encryption-configuration '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}' || true
          fi

      - name: Terraform Init
        working-directory: ./terraform
        run: |
          terraform init \
            -backend-config="bucket={% raw %}${{ steps.state-bucket.outputs.bucket_name }}{% endraw %}" \
            -backend-config="key={{ repo_name | lower }}/terraform.tfstate" \
            -backend-config="region={{ aws_region | default('us-east-1') }}"

      - name: Terraform Plan
        working-directory: ./terraform
        env:
          TF_VAR_app_env_vars: {% raw %}${{ secrets.APP_ENV_VARS_JSON }}{% endraw %}
        run: terraform plan -no-color

      - name: Terraform Apply
        working-directory: ./terraform
        env:
          TF_VAR_app_env_vars: {% raw %}${{ secrets.APP_ENV_VARS_JSON }}{% endraw %}
        run: terraform apply -auto-approve -no-color

      {% for comp in components %}
      {% if comp.aws_compute_choice == 'ec2' or (compute_choice == 'ec2' and not comp.aws_compute_choice) %}
      - name: Deploy updated container to {{ comp.name }} EC2 instance (In-Place via AWS SSM)
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        run: |
          INSTANCE_ID=$(cd terraform && terraform output -raw {{ comp.name }}_instance_id 2>/dev/null || echo "")
          if [ -n "$INSTANCE_ID" ] && [ "$INSTANCE_ID" != "null" ]; then
            echo "Checking SSM status for instance: $INSTANCE_ID"
            
            # Wait up to 60s for SSM Agent to become Online if the instance was just created
            SSM_ONLINE=false
            for i in {1..12}; do
              STATUS=$(aws ssm describe-instance-information \
                --filters "Key=InstanceIds,Values=$INSTANCE_ID" \
                --query "InstanceInformationList[0].PingStatus" \
                --output text --region {{ aws_region | default('us-east-1') }} 2>/dev/null || echo "")
              if [ "$STATUS" = "Online" ]; then
                echo "SSM Agent is Online."
                SSM_ONLINE=true
                break
              fi
              echo "SSM Agent status: '$STATUS'. Waiting 5s for agent initialization... ($i/12)"
              sleep 5
            done

            if [ "$SSM_ONLINE" = true ]; then
              echo "Refreshing container on EC2 instance: $INSTANCE_ID"
              COMMAND_ID=$(aws ssm send-command \
                --instance-ids "$INSTANCE_ID" \
                --document-name "AWS-RunShellScript" \
                --comment "Code2Cloud CD: Refresh {{ comp.name }} container" \
                --parameters 'commands=[
                  "ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)",
                  "REGION={{ aws_region | default('us-east-1') }}",
                  "aws ecr get-login-password --region $REGION | docker login --username AWS --password-stdin $ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com",
                  "docker pull $ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com/{{ repo_name | lower }}-{{ comp.name }}:latest",
                  "docker stop {{ comp.name }} || true",
                  "docker rm {{ comp.name }} || true",
                  "docker run -d --name {{ comp.name }} --restart always --env-file /opt/app/{{ comp.name }}.env -p 80:{{ comp.port | default(3000) }} $ACCOUNT_ID.dkr.ecr.$REGION.amazonaws.com/{{ repo_name | lower }}-{{ comp.name }}:latest"
                ]' \
                --query "Command.CommandId" --output text --region {{ aws_region | default('us-east-1') }})
              echo "Command sent: $COMMAND_ID. Waiting for execution..."
              aws ssm wait command-executed --command-id "$COMMAND_ID" --instance-id "$INSTANCE_ID" --region {{ aws_region | default('us-east-1') }} || echo "SSM command queued"
            else
              echo "Notice: Instance was just provisioned. Container startup is being handled automatically by EC2 user-data script."
            fi
          else
            echo "No instance ID found for {{ comp.name }}, skipping in-place SSM refresh."
          fi
      {% else %}
      - name: Trigger Rolling Deployment on ECS Service {{ comp.name }}
        if: {% raw %}${{ github.event_name != 'workflow_dispatch' || !inputs.skip_build }}{% endraw %}
        run: |
          aws ecs update-service \
            --cluster {{ repo_name | lower }}-cluster \
            --service {{ repo_name | lower }}-{{ comp.name }} \
            --force-new-deployment || true
      {% endif %}
      {% endfor %}
